# Vault Backend Configuration
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=api.vault.yourdomain.com,vault.yourdomain.com,localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=https://vault.yourdomain.com,http://localhost:3000,http://127.0.0.1:3000

# Google Authenticator TOTP Secret (Base32 format)
TOTP_SHARED_SECRET=YOUR_32_CHAR_BASE32_SECRET_KEY_HERE

# Storage Paths
VAULT_BASE_PATH=/app/vault_data
PUBLIC_BASE_URL=https://api.vault.yourdomain.com

# Frontend Environment
NEXT_PUBLIC_API_URL=https://api.vault.yourdomain.com
